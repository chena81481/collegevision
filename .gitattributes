# Standardize line endings to LF (Linux Style) for all text files
# This prevents "LF will be replaced by CRLF" warnings on Windows
* text=auto eol=lf

# Explicitly handle some file types
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.html text eol=lf

# Denote files that are truly binary and should not be modified
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
